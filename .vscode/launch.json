{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Litestar",
            "type": "debugpy",
            "request": "launch",
            "module": "litestar",
            "args": [
                "run",
            ],
            "jinja": true
        },
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "Nuke .pyc / __pycache__",
            "type": "node-terminal",
            "request": "launch",
            "command": "find . -path ./.venv -prune -o -type d -name __pycache__ -print0 | xargs -0 -r rm -rf && find . -path ./.venv -prune -o -type f -name '*.pyc' -print0 | xargs -0 -r rm -f && echo 'pyc/__pycache__ cleaned'"
        }
    ]
}